<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>ScimSlim.EntityFramework</PackageId>
    <Version>0.1.0</Version>
    <Authors>jeppevinkel</Authors>
    <Description>EF Core-backed stores for ScimSlim — drop-in SCIM User/Group persistence for ASP.NET Core homelab apps.</Description>
    <PackageTags>scim;authentik;homelab;aspnetcore;entityframework;efcore</PackageTags>
    <PackageProjectUrl>https://github.com/jeppevinkel/ScimSlim</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeppevinkel/ScimSlim</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScimSlim\ScimSlim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
  </ItemGroup>

</Project>
